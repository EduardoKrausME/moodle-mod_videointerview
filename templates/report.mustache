{{!
    @template mod_videointerview/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-videointerview-report">
    <div class="mb-3"><a class="btn btn-secondary" href="{{{manageurl}}}">{{#str}}
        manageinterview, videointerview{{/str}}</a></div>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>{{#str}}student, videointerview{{/str}}</th>
                <th>{{#str}}interviewstarted, videointerview{{/str}}</th>
                <th>{{#str}}questionsanswered, videointerview{{/str}}</th>
                <th>{{#str}}interviewsubmitted, videointerview{{/str}}</th>
                <th>{{#str}}evaluation, videointerview{{/str}}</th>
                <th>{{#str}}grade, videointerview{{/str}}</th>
                <th>{{#str}}actions{{/str}}</th>
            </tr>
            </thead>
            <tbody>{{#rows}}
                <tr>
                    <td>{{fullname}}</td>
                    <td>{{started}}</td>
                    <td>{{answered}}</td>
                    <td>{{submitted}}</td>
                    <td>{{evaluation}}</td>
                    <td>{{grade}}</td>
                    <td class="text-nowrap">
                        {{#hasattempt}}<a class="btn btn-sm btn-outline-secondary" href="{{{reviewurl}}}">{{#str}}
                            viewresponses, videointerview{{/str}}</a>{{/hasattempt}}
                        {{#cangrade}}<a class="btn btn-sm btn-primary" href="{{{gradeurl}}}">{{#str}}
                            gradeattempt, videointerview{{/str}}</a>{{/cangrade}}
                    </td>
                </tr>{{/rows}}</tbody>
        </table>
    </div>
</div>
