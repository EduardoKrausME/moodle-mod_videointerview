{{!
    @template mod_videointerview/view

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-videointerview-view">
    <h2>{{title}}</h2>
    <div class="mb-4">{{{intro}}}</div>
    {{#noquestions}}
        <div class="alert alert-info">{{#str}}noquestions, videointerview{{/str}}</div>{{/noquestions}}
    {{#hascurrent}}
        <a class="btn btn-primary" href="{{{continueurl}}}">{{#str}}
            continueinterview, videointerview{{/str}} — {{#str}}
            attempt, videointerview, {{currentattempt}}{{/str}}</a>{{/hascurrent}}
    {{#canstart}}
        <a class="btn btn-primary" href="{{{starturl}}}">{{#str}}startinterview, videointerview{{/str}}</a>{{/canstart}}
    {{#limitreached}}
        <div class="alert alert-secondary">{{#str}}attemptlimitreached, videointerview{{/str}}</div>{{/limitreached}}
    {{#haslatest}}
        <div class="card mt-4">
            <div class="card-body">
                <strong>{{#str}}attempt, videointerview, {{latestattempt}}{{/str}}</strong>: {{lateststatus}}
                {{#latestgrade}}
                    <span class="ms-3">{{#str}}grade, videointerview{{/str}}: {{latestgrade}}</span>{{/latestgrade}}
                <div class="mt-2"><a href="{{{reviewurl}}}">{{#str}}reviewresponses, videointerview{{/str}}</a></div>
            </div>
        </div>{{/haslatest}}
    <div class="mt-4 d-flex gap-2">
        {{#canmanage}}<a class="btn btn-secondary" href="{{{manageurl}}}">{{#str}}
            manageinterview, videointerview{{/str}}</a>{{/canmanage}}
        {{#canreport}}
            <a class="btn btn-secondary" href="{{{reporturl}}}">{{#str}}report, videointerview{{/str}}</a>{{/canreport}}
    </div>
</div>
