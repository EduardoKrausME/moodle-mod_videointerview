{{!
    @template mod_videointerview/answer

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-videointerview-answer">
    <h2>{{title}}</h2>
    {{#haserror}}
        <div class="alert alert-danger">{{error}}</div>{{/haserror}}
    {{#hasplayer}}
        <div class="mod-videointerview-video mb-3">{{{playerhtml}}}</div>{{/hasplayer}}
    <div class="mod-videointerview-prompt mb-4">{{{prompthtml}}}</div>
    {{#timed}}
        <div class="alert alert-info" data-videointerview-timer data-seconds="{{remaining}}">{{#str}}
            timeleft, videointerview{{/str}}: <strong data-timer-value></strong></div>{{/timed}}
    <form method="post" action="{{{formaction}}}" enctype="multipart/form-data" data-videointerview-answer-form>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <div class="mb-3"><label class="form-label" for="responsetype">{{#str}}
            responsetype, videointerview{{/str}}</label>
            <select class="form-select" id="responsetype" name="responsetype" data-response-type>
                {{#types}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/types}}
            </select>
        </div>
        <div class="mb-3" data-text-response><label class="form-label" for="textresponse">{{#str}}
            textresponse, videointerview{{/str}}</label>
            <textarea class="form-control" id="textresponse" name="textresponse" rows="8">{{textresponse}}</textarea>
        </div>
        <div class="mb-3" data-media-response>
            <label class="form-label" for="mediafile">{{#str}}mediafile, videointerview{{/str}}</label>
            <input class="form-control" type="file" id="mediafile" name="mediafile" data-media-file
                   accept="audio/*,video/*">
            <div class="mt-2 d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-secondary" data-record-audio>{{#str}}
                    recordaudio, videointerview{{/str}}</button>
                <button type="button" class="btn btn-outline-secondary" data-record-video>{{#str}}
                    recordvideo, videointerview{{/str}}</button>
                <button type="button" class="btn btn-outline-danger d-none" data-stop-recording>{{#str}}
                    stoprecording, videointerview{{/str}}</button>
            </div>
            <div class="form-text" data-recording-status></div>
            <video class="mt-2 d-none mod-videointerview-recording-preview" controls data-recording-preview></video>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">{{#str}}saveandcontinue, videointerview{{/str}}</button>
            {{#canreview}}<a class="btn btn-link" href="{{{reviewurl}}}">{{#str}}
                reviewresponses, videointerview{{/str}}</a>{{/canreview}}
        </div>
    </form>
</div>
