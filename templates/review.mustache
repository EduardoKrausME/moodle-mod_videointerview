{{!
    @template mod_videointerview/review

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-videointerview-review">
    <h2>{{title}} — {{#str}}attempt, videointerview, {{attempt}}{{/str}}</h2>
    {{#missingrequired}}
        <div class="alert alert-warning">{{#str}}responsemissing, videointerview{{/str}}</div>{{/missingrequired}}
    <div class="list-group mb-4">
        {{#questions}}
            <div class="list-group-item">
                <div class="d-flex justify-content-between gap-3"><strong>{{title}}</strong>{{#required}}
                    <span class="badge bg-secondary">{{#str}}required{{/str}}</span>{{/required}}</div>
                <div class="mt-2">{{{answerhtml}}}</div>
                {{#canedit}}
                    <div class="mt-2"><a class="btn btn-sm btn-outline-primary" href="{{{editurl}}}">{{#str}}
                        edit{{/str}}</a></div>{{/canedit}}
            </div>{{/questions}}
    </div>
    {{#hasgrade}}
        <div class="alert alert-success"><strong>{{#str}}grade, videointerview{{/str}}:</strong> {{grade}}
        </div>{{/hasgrade}}
    {{#hasfeedback}}
        <div class="card mb-3">
            <div class="card-body">{{{feedbackhtml}}}</div>
        </div>{{/hasfeedback}}
    <div class="d-flex gap-2">
        {{#cansubmit}}<a class="btn btn-primary" href="{{{submiturl}}}"
                         data-confirm="{{#str}}submitconfirm, videointerview{{/str}}">{{#str}}
            submitinterview, videointerview{{/str}}</a>{{/cansubmit}}
        <a class="btn btn-secondary" href="{{{backurl}}}">{{#str}}back{{/str}}</a>
    </div>
</div>
